nmap_scan()
{
    local domain="${1:-${DOMAIN:-}}"
    domain="${domain%.}"
    local output_file="${2:-${domain}_nmap.txt}"

    if [[ ! "$domain" =~ ^([[:alnum:]]([[:alnum:]-]{0,61}[[:alnum:]])?\.)+[[:alpha:]]{2,63}$ ]]; then
        printf 'Usage: nmap_scan <domain> [output-file]\n' >&2
        return 2
    fi

    if ! command -v nmap >/dev/null 2>&1; then
        printf 'Error: nmap is required but was not found in PATH.\n' >&2
        return 127
    fi

    nmap -F -T2 -oN "$output_file" "$domain"
}
