traceroute_scan()
{
    local domain="${1:-${DOMAIN:-}}"
    domain="${domain%.}"
    local output_file="${2:-${domain}_netroute.txt}"

    if [[ ! "$domain" =~ ^([[:alnum:]]([[:alnum:]-]{0,61}[[:alnum:]])?\.)+[[:alpha:]]{2,63}\.?$ ]]; then
        printf 'Usage: wired <domain> \n' >&2
        return 2
    fi

    if ! command -v traceroute >/dev/null 2>&1; then
        printf 'Error: traceroute is required but was not found in PATH.\n' >&2
        return 127
    fi

    traceroute "$domain" > "$output_file"
